# Copy to .env and fill in. Never commit .env.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Gemini Live-capable model id (half-cascade default for function-calling
# reliability; gemini-live-2.5-flash-native-audio for native-audio voice quality)
LIVE_MODEL=gemini-3.1-flash-live-preview

# Session persistence (in-memory by default; Redis optional, see ADR-003)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# DuckDB recipe database (Phase 5)
RECIPES_DB_PATH=data/recipes.db
# Relevance floor for semantic recipe search (Euclidean distance, 0-2)
RECIPE_MAX_DISTANCE=1.0

# Shared access token for the voice WebSocket (Phase 7). Leave unset for
# open access on a trusted LAN/local dev; set it before exposing the app
# publicly. Share the page URL as "https://host/?token=<value>"; the clients
# forward it to the WebSocket as a subprotocol, never as a query parameter.
APP_AUTH_TOKEN=

# Comma-separated CORS origins. "*" is honoured but drops credentials, because
# browsers reject a credentialed wildcard anyway.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
